# The sharded data tree is 62 MB and is rebuilt every cycle, so it lives in
# object storage (gs://virgil-web) rather than in git — committing it would add
# megabytes of objects a day. The page itself is committed, so pushing here is
# what deploys the site.
ui/data/
ui/_smoke.html

# Ingest working set: caches, per-filing scans, price history. Rebuildable from
# EDGAR, and the large caches already live in GCS (see ingest/store.py).
data/

# Never: API keys live in ~/.virgil/credentials, outside the tree.
.virgil/
*.key
.env
.env.*

.DS_Store
__pycache__/
*.pyc
*.tmp
.vercel/
.vercel
